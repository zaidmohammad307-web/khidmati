<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="privilege_manufacturing" model="res.groups.privilege">
    <field name="name">Production Planning</field>
    <field name="sequence">5</field>
    <field name="category_id" ref="base.module_category_supply_chain"/>
  </record>
  <record id="group_user" model="res.groups">
    <field name="name">Manufacturing Access</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('base.group_user')),(4,ref('mrp.group_mrp_user'))]"/>
  </record>
  <record id="group_planner" model="res.groups">
    <field name="name">Production Planner</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('deep_core.group_user')),(4,ref('hr.group_hr_user'))]"/>
  </record>
  <record id="group_warehouse" model="res.groups">
    <field name="name">Warehouse Operator</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('deep_core.group_user'))]"/>
  </record>
  <record id="group_operator" model="res.groups">
    <field name="name">Production Operator</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('deep_core.group_user'))]"/>
  </record>
  <record id="group_qa" model="res.groups">
    <field name="name">Quality Tester</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('deep_core.group_user'))]"/>
  </record>
  <record id="group_technician" model="res.groups">
    <field name="name">Rework Technician</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('deep_core.group_user'))]"/>
  </record>
  <record id="group_supervisor" model="res.groups">
    <field name="name">Production Supervisor</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('deep_core.group_user')),(4,ref('deep_core.group_operator'))]"/>
  </record>
  <record id="group_procurement" model="res.groups">
    <field name="name">Procurement User</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('deep_core.group_user')),(4,ref('purchase.group_purchase_user'))]"/>
  </record>
  <record id="group_manager" model="res.groups">
    <field name="name">Manufacturing Manager</field>
    <field name="privilege_id" ref="privilege_manufacturing"/>
    <field name="implied_ids" eval="[(4,ref('mrp.group_mrp_manager')),(4,ref('stock.group_stock_manager')),(4,ref('purchase.group_purchase_manager')),(4,ref('hr.group_hr_user')),(4,ref('deep_core.group_planner')),(4,ref('deep_core.group_warehouse')),(4,ref('deep_core.group_operator')),(4,ref('deep_core.group_qa')),(4,ref('deep_core.group_technician')),(4,ref('deep_core.group_supervisor')),(4,ref('deep_core.group_procurement'))]"/>
    <field name="user_ids" eval="[(4,ref('base.user_admin')),(4,ref('base.user_root'))]"/>
  </record>
</odoo>
