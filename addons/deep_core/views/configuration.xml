<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="company_procurement_configuration" model="ir.ui.view">
    <field name="name">company.deep.procurement.configuration</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Manufacturing Procurement" groups="deep_core.group_manager">
          <field name="deep_procurement_mode"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
