<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <menuitem id="menu_module" name="Risk" parent="deep_core.menu_root" sequence="60"/>
  <record id="deep_material_risk_list" model="ir.ui.view">
    <field name="name">deep_material_risk.list</field>
    <field name="model">deep.material.risk</field>
    <field name="arch" type="xml">
      <list string="Material Criticality" create="0" delete="0">
        <field name="product_id"/>
        <field name="score"/>
        <field name="supplier_count"/>
        <field name="lead_days"/>
        <field name="final_bom_count"/>
      </list>
    </field>
  </record>
  <record id="deep_material_risk_form" model="ir.ui.view">
    <field name="name">deep_material_risk.form</field>
    <field name="model">deep.material.risk</field>
    <field name="arch" type="xml">
      <form string="Material Criticality" create="0" delete="0">
        <header>
          <button name="action_refresh" type="object" string="Refresh Risk" class="btn-secondary"/>
          <button name="action_export" type="object" string="Export Risk" class="btn-secondary"/>
        </header>
        <sheet>
          <group>
            <field name="product_id"/>
            <field name="score"/>
            <field name="supplier_count"/>
            <field name="lead_days"/>
            <field name="final_bom_count"/>
            <field name="total_bom_usage"/>
            <field name="average_price"/>
            <field name="last_price"/>
            <field name="reasons"/>
            <field name="at"/>
            <field name="company_id"/>
          </group>
          <notebook/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="deep_material_risk_action" model="ir.actions.act_window">
    <field name="name">Material Criticality</field>
    <field name="res_model">deep.material.risk</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="deep_material_risk_menu" name="Material Criticality" parent="menu_module" action="deep_material_risk_action"/>
</odoo>
