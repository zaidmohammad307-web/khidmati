<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <menuitem id="menu_module" name="Dashboard" parent="deep_core.menu_root" sequence="70"/>
  <record id="deep_quality_summary_list" model="ir.ui.view">
    <field name="name">deep_quality_summary.list</field>
    <field name="model">deep.quality.summary</field>
    <field name="arch" type="xml">
      <list string="Quality Analytics" create="0" delete="0">
        <field name="unit_id"/>
        <field name="product_id"/>
        <field name="state"/>
        <field name="first_pass"/>
        <field name="last_pass"/>
        <field name="retested"/>
      </list>
    </field>
  </record>
  <record id="deep_quality_summary_form" model="ir.ui.view">
    <field name="name">deep_quality_summary.form</field>
    <field name="model">deep.quality.summary</field>
    <field name="arch" type="xml">
      <form string="Quality Analytics" create="0" delete="0">
        <sheet>
          <group>
            <field name="unit_id"/>
            <field name="product_id"/>
            <field name="state"/>
            <field name="first_pass"/>
            <field name="last_pass"/>
            <field name="retested"/>
            <field name="tested"/>
            <field name="retest_pass"/>
            <field name="company_id"/>
          </group>
          <notebook/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="deep_quality_summary_action" model="ir.actions.act_window">
    <field name="name">Quality Analytics</field>
    <field name="res_model">deep.quality.summary</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="deep_quality_summary_menu" name="Quality Analytics" parent="menu_module" action="deep_quality_summary_action"/>
  <record id="deep_schedule_change_list" model="ir.ui.view">
    <field name="name">deep_schedule_change.list</field>
    <field name="model">deep.schedule.change</field>
    <field name="arch" type="xml">
      <list string="Reschedule Work Order">
        <field name="workorder_id"/>
        <field name="start"/>
      </list>
    </field>
  </record>
  <record id="deep_schedule_change_form" model="ir.ui.view">
    <field name="name">deep_schedule_change.form</field>
    <field name="model">deep.schedule.change</field>
    <field name="arch" type="xml">
      <form string="Reschedule Work Order">
        <header>
          <button name="action_apply" type="object" string="Apply with Audit" class="btn-primary"/>
        </header>
        <sheet>
          <group>
            <field name="workorder_id"/>
            <field name="start"/>
            <field name="reason"/>
          </group>
          <notebook/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="deep_schedule_change_action" model="ir.actions.act_window">
    <field name="name">Reschedule Work Order</field>
    <field name="res_model">deep.schedule.change</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_cockpit" model="ir.actions.client">
    <field name="name">Planning Cockpit</field>
    <field name="tag">deep.cockpit</field>
  </record>
  <menuitem id="menu_cockpit" name="Planning Cockpit" parent="deep_core.menu_root" action="action_cockpit" sequence="1" groups="deep_core.group_planner,deep_core.group_supervisor,deep_core.group_qa,deep_core.group_procurement,deep_core.group_manager"/>
</odoo>
