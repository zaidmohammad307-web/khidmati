    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <header>
          <button name="action_run" type="object" string="Run refresh now" class="btn-primary" invisible="state not in ['queued','retry']"/>
          <button name="action_cancel" type="object" string="Cancel pending refresh" invisible="state not in ['queued','retry']" groups="deep_core.group_manager"/>
        </header>
        <sheet>
          <group>
            <field name="profile_id"/>
            <field name="company_id"/>
            <field name="requested_by"/>
            <field name="state"/>
            <field name="attempts"/>
            <field name="queued_at"/>
            <field name="started_at"/>
            <field name="finished_at"/>
            <field name="next_attempt"/>
            <field name="error_code"/>
            <field name="message"/>
            <field name="counts_json"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
