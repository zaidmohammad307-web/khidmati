<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <menuitem id="menu_sap" name="SAP Business One" parent="deep_core.menu_root" sequence="90" groups="deep_core.group_planner,deep_core.group_procurement,deep_core.group_manager"/>
  <record id="view_deep_sap_profile_list" model="ir.ui.view">
    <field name="name">deep.sap.profile.list</field>
    <field name="model">deep.sap.profile</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="company_id"/>
        <field name="connection_state"/>
        <field name="last_success"/>
        <field name="automatic_sync"/>
        <field name="status_message"/>
      </list>
    </field>
  </record>
  <record id="view_deep_sap_profile_form" model="ir.ui.view">
    <field name="name">deep.sap.profile.form</field>
    <field name="model">deep.sap.profile</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_test_connection" type="object" string="Test VPN connection" class="btn-secondary" groups="deep_core.group_procurement,deep_core.group_manager"/>
          <button name="action_queue_sync" type="object" string="Refresh SAP data" class="btn-primary" groups="deep_core.group_planner,deep_core.group_procurement,deep_core.group_manager"/>
          <field name="connection_state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="alert alert-info">Credentials are read from private server secrets. Use the VPN hostname on the SAP certificate. Native stock reconciliation and BOM activation require separate approval.</div>
          <group>
            <field name="name"/>
            <field name="company_id"/>
            <field name="base_url"/>
            <field name="environment_prefix"/>
            <field name="automatic_sync"/>
            <field name="interval_minutes"/>
            <field name="max_age_minutes"/>
            <field name="max_records"/>
            <field name="sync_partners"/>
            <field name="sync_purchase"/>
            <field name="sync_sales"/>
            <field name="sync_boms"/>
          </group>
          <group>
            <field name="last_success"/>
            <field name="last_check"/>
            <field name="sap_version"/>
            <field name="status_message"/>
          </group>
          <notebook>
            <page string="Warehouses">
              <field name="warehouse_ids">
                <list editable="bottom">
                  <field name="sap_code"/>
                  <field name="warehouse_id"/>
                  <field name="location_id"/>
                </list>
              </field>
            </page>
            <page string="Inventory units">
              <field name="uom_ids">
                <list editable="bottom">
                  <field name="sap_name"/>
                  <field name="uom_id"/>
                  <field name="quantity_factor"/>
                </list>
              </field>
            </page>
            <page string="Refresh history">
              <field name="job_ids">
                <list create="0" delete="0">
                  <field name="id"/>
                  <field name="state"/>
                  <field name="queued_at"/>
                  <field name="finished_at"/>
                  <field name="attempts"/>
                  <field name="message"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
