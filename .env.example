# Run: python scripts/manage.py setup
# Setup generates four independent passwords, a backup key and local TLS certificates.
COMPOSE_PROJECT_NAME=drone_odoo
ODOO_IMAGE=odoo:19.0-20260926@sha256:77bac5cd1e065210828f34883a7f76740b7373d06dd3a5a55d3eeb31ee2f85cd
POSTGRES_IMAGE=postgres:16-bookworm@sha256:efedf3595f1d6f415c08568ba171029bf54052e754cc9f030e3f2412b21f3d67
ODOO_HTTP_PORT=8069
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_NAME=deep_pilot
ODOO_DB_USER=odoo_app
ODOO_DB_PASSWORD=
ODOO_ADMIN_PASSWD=
ODOO_LOGIN=admin
ODOO_LOGIN_PASSWORD=
ODOO_BOOTSTRAP_MODULES=base,web,mrp,purchase_stock,hr,deep_sap_b1

# Pilot demo is created only on initial module installation.
DEEP_DEMO_ENABLED=1

# Secure deployment is the default. Point data storage at an encrypted disk/mount.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.secure.yml
DEEP_ENCRYPTED_DATA_DIR=
DEEP_BACKUP_KEY_FILE=secrets/backup.key
DEEP_HOSTNAME=localhost
DEEP_BIND_ADDRESS=127.0.0.1
DEEP_HTTPS_PORT=8443
CADDY_IMAGE=caddy:2.11.7-alpine

# SAP B1 Service Layer. Set the VPN FQDN visible from the Odoo container.
SAP_B1_BASE_URL=
SAP_B1_ALLOWED_ENDPOINTS=
SAP_B1_COMPANY_DB=
SAP_B1_USERNAME=
SAP_B1_PASSWORD_FILE=/var/lib/odoo/deep-secrets/sap-password.txt
SAP_B1_CA_BUNDLE=
